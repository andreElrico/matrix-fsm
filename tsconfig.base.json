{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "ignoreDeprecations": "6.0",
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@matrix-fsm/source"],
    "baseUrl": ".",
    "paths": {
      "@matrix-fsm/core": ["packages/core/src/index.ts"],
      "@matrix-fsm/angular/effect": ["packages/angular/src/effect/index.ts"],
      "@matrix-fsm/angular": ["packages/angular/src/index.ts"],
      "@matrix-fsm/eslint-plugin": ["packages/eslint-plugin/src/index.ts"],
      "@matrix-fsm/router": ["packages/router/src/index.ts"]
    }
  }
}
